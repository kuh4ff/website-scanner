{
  "manifest_version": 3,
  "name": "NEXUS Scanner Pro",
  "version": "4.0.0",
  "description": "Professional security scanner - CSP bypass, GitHub sync, terminal bridge, AI integration, Remote Config",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "clipboardWrite",
    "clipboardRead",
    "alarms",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NEXUS Scanner Pro"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_start",
    "all_frames": false
  }],
  "web_accessible_resources": [{
    "resources": ["injected.js"],
    "matches": ["<all_urls>"]
  }]
}
